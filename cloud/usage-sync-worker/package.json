{
  "name": "dsh-cockpit-usage-sync-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH 驾驶舱可选团队共享同步 Worker（Cloudflare Workers + D1，零运行时依赖）",
  "license": "MIT",
  "scripts": {
    "test": "node --test ../../test/sync.test.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply dsh-cockpit-sync --local",
    "db:migrate:remote": "wrangler d1 migrations apply dsh-cockpit-sync --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.15"
  }
}
